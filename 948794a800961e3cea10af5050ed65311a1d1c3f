      "writtenOn": "2026-09-30T18:19:00Z",
      "side": 1,
      "message": "I don\u0027t believe we should throw this exception when the CAS doesn\u0027t win the race. We should just return `false` instead.",
      "range": {
        "startLine": 226,
        "startChar": 12,
        "endLine": 226,
        "endChar": 67
      },
      "revId": "948794a800961e3cea10af5050ed65311a1d1c3f",
